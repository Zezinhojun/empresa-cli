{
  "compilerOptions": {
    /* =========================================================
     * OUTPUT (build da CLI)
     * ========================================================= */
    "rootDir": "./src",
    "outDir": "./dist",

    /* =========================================================
     * NODE ESM MODERNO (CLI runtime)
     * ========================================================= */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    /* =========================================================
     * TYPES (ambiente Node CLI)
     * ========================================================= */
    "types": ["node", "vitest"],
    "lib": ["ES2022"],

    /* =========================================================
     * STRICT MODE (evita bugs em automação)
     * ========================================================= */
    "strict": true,

    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* =========================================================
     * MODULE SAFETY (CLI architecture importante)
     * ========================================================= */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* =========================================================
     * OUTPUT QUALITY (debug + distribui CLI)
     * ========================================================= */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* =========================================================
     * PERFORMANCE (evita overhead desnecessário)
     * ========================================================= */
    "skipLibCheck": true
  },

  /* =========================================================
   * INPUT / OUTPUT CONTROL
   * ========================================================= */
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
