{
  "name": "cli-vox",
  "version": "1.0.0",
  "description": "CLI interna para automação de tarefas da empresa",
  "author": "José Antônio jose.antonio@voxtecnologia.com",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vox": "./dist/index.js"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.39.4",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "tsup": "^8.5.1",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
