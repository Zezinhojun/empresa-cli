{
  "name": "mycli",
  "version": "1.0.0",
  "description": "CLI para automatizar tarefas com scripts seus",
  "author": "Seu Nome <voce@exemplo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/REPO.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/REPO/issues"
  },
  "homepage": "https://github.com/OWNER/REPO#readme",
  "keywords": [
    "cli",
    "mycli",
    "automation",
    "devops"
  ],
  "files": [
    "dist",
    "mycli-scripts",
    "!mycli-scripts/README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "mycli": "./dist/index.js"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsup && node dist/index.js",
    "build": "tsup && npm run scripts:index",
    "start": "node dist/index.js",
    "contract": "npm run build && vitest run --config vitest.contract.config.ts",
    "scripts:index": "tsx scripts/build-scripts-index.ts",
    "backlog": "tsx scripts/backlog.ts",
    "init": "node scripts/init.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^6.0.1",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.39.4",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
